{{!
    @template tool_configascode/configascode_check

    This template renders the response for the secure config check.

    Example context (json):
    {
        "env": "PROD001",
        "normalisedenv": "prod",
        "bootstrapexists": true,
        "policypath": "admin/tool/configascode/policies/prod.php",
        "policyfileexists": true,
        "istesting": false,
        "currenthash": "abc123",
        "storedhash": "abc123",
        "storedtime": 1713350400,
        "hashmatches": true,
        "synctaskenabled": true,
        "synclogsurl": "http://localhost/admin/tasklogs.php?filter=%5Ctool_configascode%5Ctask%5Csync_policy_task"
    }
}}
<div class="tool-lockdown-config-check"
     data-env="{{env}}"
     data-normalisedenv="{{normalisedenv}}"
     data-testing="{{#istesting}}yes{{/istesting}}{{^istesting}}no{{/istesting}}"
     data-config-bootstrap="{{#bootstrapexists}}yes{{/bootstrapexists}}{{^bootstrapexists}}no{{/bootstrapexists}}"
     data-policy-file-exists="{{#policyfileexists}}yes{{/policyfileexists}}{{^policyfileexists}}no{{/policyfileexists}}"
     data-policy-path="{{policypath}}"
     data-current-hash="{{currenthash}}"
     data-stored-hash="{{storedhash}}"
     data-policy-sync-time="{{storedtime}}"
     data-hash-matches="{{#hashmatches}}yes{{/hashmatches}}{{^hashmatches}}no{{/hashmatches}}"
     data-sync-task-enabled="{{#synctaskenabled}}yes{{/synctaskenabled}}{{^synctaskenabled}}no{{/synctaskenabled}}"
     data-synclogsurl="{{synclogsurl}}">
    <h4>{{#str}}checkconfigascode_environment, tool_configascode{{/str}}</h4>
    <p>
        {{#istesting}}{{#str}}checkconfigascode_testingenvironment, tool_configascode{{/str}}{{/istesting}}{{^istesting}}{{env}}{{/istesting}}
    </p>
    <h4>{{#str}}checkconfigascode_normalisedenvironment, tool_configascode{{/str}}</h4>
    <p>{{normalisedenv}}</p>
    <h4>{{#str}}checkconfigascode_policybootstrap, tool_configascode{{/str}}</h4>
    <p>
        {{#bootstrapexists}}{{#str}}yes{{/str}}{{/bootstrapexists}}{{^bootstrapexists}}{{#str}}no{{/str}}{{/bootstrapexists}}
    </p>
    <h4>{{#str}}checkconfigascode_policyfileexists, tool_configascode{{/str}}</h4>
    <p>
        {{#policyfileexists}}{{#str}}yes{{/str}}{{/policyfileexists}}{{^policyfileexists}}{{#str}}no{{/str}}{{/policyfileexists}}
    </p>
    <h4>{{#str}}checkconfigascode_resolvedpolicyfile, tool_configascode{{/str}}</h4>
    <p>{{policypath}}</p>
    <h4>{{#str}}checkconfigascode_currenthash, tool_configascode{{/str}}</h4>
    <p>{{currenthash}}</p>
    <h4>{{#str}}checkconfigascode_synctaskenabled, tool_configascode{{/str}}</h4>
    <p>{{#synctaskenabled}}{{#str}}yes{{/str}}{{/synctaskenabled}}{{^synctaskenabled}}{{#str}}no{{/str}}{{/synctaskenabled}}</p>
    <h4>{{#str}}checkconfigascode_policysynchash, tool_configascode{{/str}}</h4>
    <p>
        {{#hashmatches}}{{#str}}checkconfigascode_hashmatches_yes, tool_configascode{{/str}}{{/hashmatches}}{{^hashmatches}}{{#str}}checkconfigascode_hashmatches_no, tool_configascode{{/str}}{{/hashmatches}}
    </p>
    <h4>{{#str}}checkconfigascode_policysynctime, tool_configascode{{/str}}</h4>
    <p>{{#storedtime}}{{#userdate}} {{storedtime}}, {{#str}} strftimedatetimeaccurate, core_langconfig {{/str}} {{/userdate}}{{/storedtime}}{{^storedtime}}{{#str}}checkconfigascode_timenotset, tool_configascode{{/str}}{{/storedtime}}</p>
    <h4>{{#str}}checkconfigascode_synclogsurl, tool_configascode{{/str}}</h4>
    <p><a href="{{synclogsurl}}">{{#str}}checkconfigascode_synclogsurl, tool_configascode{{/str}}</a></p>
    <h4>{{#str}}checkconfigascode_storedhash, tool_configascode{{/str}}</h4>
    <p>{{#storedhash}}{{storedhash}}{{/storedhash}}{{^storedhash}}{{#str}}checkconfigascode_hashnotset, tool_configascode{{/str}}{{/storedhash}}</p>
</div>
